<Window x:Class="EmployeeManagement.UI.EmployeeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chi tiết nhân viên" Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#BDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0">
            <TextBlock x:Name="HeaderTextBlock" 
                       Text="THÊM NHÂN VIÊN MỚI" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       VerticalAlignment="Center" 
                       Margin="20,0"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ tên *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="FullNameTextBox" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày sinh" Style="{StaticResource LabelStyle}"/>
                            <DatePicker x:Name="DateOfBirthPicker" FontSize="13" Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giới tính" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="GenderComboBox" Style="{StaticResource ComboBoxStyle}">
                                <ComboBoxItem Content="Nam"/>
                                <ComboBoxItem Content="Nữ"/>
                                <ComboBoxItem Content="Khác"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Địa chỉ" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="AddressTextBox" Style="{StaticResource TextBoxStyle}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="PhoneNumberTextBox" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email *" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="EmailTextBox" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Phòng ban" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="DepartmentComboBox" 
                                      Style="{StaticResource ComboBoxStyle}"
                                      DisplayMemberPath="DepartmentName"
                                      SelectedValuePath="DepartmentId"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chức vụ" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="PositionComboBox" 
                                      Style="{StaticResource ComboBoxStyle}"
                                      DisplayMemberPath="PositionTitle" 
                                      SelectedValuePath="PositionId"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mức lương (VNĐ)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="BaseSalaryTextBox" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ngày bắt đầu *" Style="{StaticResource LabelStyle}"/>
                            <DatePicker x:Name="HireDatePicker" FontSize="13" Padding="8"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Trạng thái" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="EmploymentStatusComboBox" Style="{StaticResource ComboBoxStyle}" Margin="0,0,0,15">
                        <ComboBoxItem Content="Active" IsSelected="True"/>
                        <ComboBoxItem Content="Terminated"/> 👈 **Sử dụng Terminated như trong DB**
                        <ComboBoxItem Content="On Leave"/>
                    </ComboBox>

                    <StackPanel x:Name="PasswordPanel" Visibility="Visible">
                        <TextBlock Text="Mật khẩu *" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="PasswordBox" FontSize="13" Padding="8" Margin="0,0,0,5"/>
                        <TextBlock Text="(Mật khẩu mặc định: 123456)" 
                                   FontSize="11" 
                                   Foreground="#757575" 
                                   Margin="0,0,0,15"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ảnh đại diện" Style="{StaticResource LabelStyle}"/>
                    <Border BorderBrush="#BDBDBD" 
                            BorderThickness="2" 
                            CornerRadius="5" 
                            Width="200" 
                            Height="200" 
                            Margin="0,0,0,10"
                            Background="#F5F5F5">
                        <Grid>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="👤"
                                       FontSize="80"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#BDBDBD"/>
                            <Image x:Name="ProfilePictureImage" 
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Button x:Name="UploadPhotoButton" 
                            Content="📷 Tải ảnh lên" 
                            Click="UploadPhotoButton_Click"
                            Background="#4CAF50" 
                            Foreground="White" 
                            Padding="10,8" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Margin="0,0,0,10">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="RemovePhotoButton" 
                            Content="🗑️ Xóa ảnh" 
                            Click="RemovePhotoButton_Click"
                            Background="#F44336" 
                            Foreground="White" 
                            Padding="10,8" 
                            BorderThickness="0" 
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <Button x:Name="SaveButton" 
                        Content="💾 Lưu" 
                        Click="SaveButton_Click"
                        Background="#4CAF50" 
                        Foreground="White" 
                        Padding="30,10" 
                        Margin="10"
                        BorderThickness="0" 
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="❌ Hủy" 
                        Click="CancelButton_Click"
                        Background="#757575" 
                        Foreground="White" 
                        Padding="30,10" 
                        Margin="10"
                        BorderThickness="0" 
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>